# StrikerAPI credentials
STRIKER_API_KEY=

# Competition (laliga | ucl | ...)
STRIKER_COMPETITION=laliga

# Storage
STRIKER_DB_PATH=curated/striker.db
STRIKER_RAW_DIR=raw

# Credit budget (monthly)
STRIKER_MONTHLY_BUDGET=10000
STRIKER_RESERVE_CREDITS=500

# Saldo REAL disponible ahora mismo (0 = desconocido).
# Si lo informas, el tope de gasto es min(MONTHLY_BUDGET, CREDITS_REMAINING)
# y el rate-limit se frena solo cuando el saldo RESTANTE baja de 100.
STRIKER_CREDITS_REMAINING=0

# Rate limits (documented by StrikerAPI)
STRIKER_RATE_PER_MINUTE=60
STRIKER_LOW_BALANCE_RATE=10
STRIKER_LOW_BALANCE_THRESHOLD=100

# Network
STRIKER_TIMEOUT=30
STRIKER_MAX_RETRIES=4
STRIKER_BACKOFF_BASE=2.0